{
  "name": "@runas-codex/desktop",
  "version": "0.1.0-beta.21",
  "private": true,
  "description": "Casca desktop (Electron) do Runas-Codex para Windows e Linux",
  "main": "out/main/index.js",
  "author": "João Antonio",
  "homepage": "https://github.com/Player07x/Runas-Codex",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "smoke": "electron-vite build && electron . --smoke",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dist:linux": "electron-vite build && electron-builder --linux deb AppImage --publish never",
    "dist:win": "electron-vite build && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.4.2",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "fflate": "0.8.3",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  },
  "build": {
    "appId": "dev.runas.codex",
    "productName": "Runas-Codex",
    "copyright": "Runas Suite",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Runas-Codex-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Runas-Codex",
      "uninstallDisplayName": "Runas-Codex",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "executableName": "runas-codex",
      "maintainer": "João Antonio <joaoantoniobr07@gmail.com>",
      "synopsis": "Notas compatíveis com o Obsidian, wiki, campanhas, livros, agenda e VTT, offline",
      "artifactName": "Runas-Codex-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Runas-Codex",
          "StartupWMClass": "runas-codex"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2t64 | libasound2",
        "pkexec | policykit-1"
      ]
    },
    "extraResources": [
      {
        "from": "resources/dicionarios",
        "to": "dicionarios"
      }
    ],
    "protocols": [
      {
        "name": "Runas-Codex",
        "schemes": [
          "runas"
        ]
      }
    ]
  },
  "desktopName": "runas-codex.desktop"
}
