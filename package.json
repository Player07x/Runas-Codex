{
  "name": "runas-codex",
  "version": "0.1.0-beta.21",
  "private": true,
  "description": "Runas-Codex: notas compatíveis com o Obsidian, wiki, campanhas, livros, agenda e VTT, offline",
  "workspaces": [
    "app",
    "desktop",
    "mobile"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @runas-codex/app",
    "dev:rede": "npm run dev -w @runas-codex/app -- --host",
    "build": "npm run build -w @runas-codex/app",
    "preview": "npm run preview -w @runas-codex/app",
    "desktop": "npm run dev -w @runas-codex/desktop",
    "desktop:build": "npm run build -w @runas-codex/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "android": "npm run sync -w @runas-codex/mobile"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": false
  },
  "overrides": {
    "katex": "0.18.9"
  }
}
